generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Medicine {
  id          String   @id @default(uuid())
  name        String
  category    Category
  price       Float
  stock       Int
  description String
  dosage      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Doctor {
  id                String    @id @default(uuid())
  doctorName        String
  doctorSpecialty   String
  doctorEmail       String    @unique
  doctorPassword    String    // Added password field
  doctorPhone       String
  doctorAddress     String
  doctorExperience  String
  profileImage      String?
  doctorWorkingHours String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum Category {
  PAIN_RELIEF
  ANTIBIOTICS
  ALLERGY
  DIGESTIVE_HEALTH
}
